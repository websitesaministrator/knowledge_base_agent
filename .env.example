# Required — copy this to .env and fill in real values
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Optional: GCP / Firestore (for production deploy)
GCP_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# App settings
KB_DATA_PATH=data/ps03_support_tickets.csv
CHROMA_PERSIST_DIR=chroma_db
LOG_LEVEL=INFO
